<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ParaBank FinTech Automation Suite" verbose="1">

    <listeners>
        <listener class-name="com.parabank.listeners.TestListener" />
    </listeners>

    <parameter name="browser" value="chrome" />

    <test name="Banking Core Workflows">
        <classes>
            <class name="com.parabank.tests.AccountRegistrationTest" />
            <class name="com.parabank.tests.LoginTest" />
            <class name="com.parabank.tests.FundTransferTest" />
            <class name="com.parabank.tests.BillPaymentTest" />
            <class name="com.parabank.tests.LoanApplicationTest" />
        </classes>
    </test>

</suite>
